# Copy to .env and adjust. Values below are safe local defaults.
DATABASE_URL=postgresql+psycopg://queueless:queueless_local@127.0.0.1:5432/queueless
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MIN=720
# log = write emails to worker log/console (no credentials needed). smtp = deliver via SMTP.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=queueless@demo.local
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=http://localhost:5173
OTP_EXPIRY_MIN=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
ARRIVAL_BUFFER_MIN=15
INCIDENT_RESPONSE_MIN=30
# Configurable queue behaviour
SERVICE_DURATION_MIN=6.2
NO_SHOW_GRACE_MIN=3
ETA_ALERT_THRESHOLD_MIN=15
SLA_TARGET_WAIT_MIN=20
RATE_LIMIT_ENABLED=true
